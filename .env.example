# Example Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to source control

# Database Connection String
# Format: Server=<host>;Port=<port>;Database=<dbname>;User=<username>;Password=<password>;
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=<database>;User=<username>;Password=<password>

# CORS Allowed Origins (comma-separated)
# Example: https://example.com,https://www.example.com
Cors__AllowedOrigins__0=https://localhost:7182
# Add more origins as needed:
# Cors__AllowedOrigins__1=https://yourdomain.com
# Cors__AllowedOrigins__2=https://admin.yourdomain.com

# Keycloak Configuration
# The base URL of your Keycloak server (e.g., https://keycloak.example.com or http://localhost:8080)
Keycloak__Authority=http://localhost:8080
# The realm name in Keycloak
Keycloak__Realm=qms-realm
# The client ID registered in Keycloak for this API
Keycloak__ClientId=qms-api
# Client secret (optional, only needed for confidential clients)
# Keycloak__ClientSecret=your-client-secret-here
# Whether to require HTTPS for metadata (set to false for local development)
Keycloak__RequireHttpsMetadata=false
# Token validation settings
Keycloak__ValidateIssuer=true
Keycloak__ValidateAudience=true
Keycloak__ValidateLifetime=true
# Clock skew for token validation in seconds (default: 300 = 5 minutes)
Keycloak__ClockSkewSeconds=300

# Logging Configuration (optional)
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Application Settings
AllowedHosts=*
