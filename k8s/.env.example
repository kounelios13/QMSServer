# Kubernetes Configuration Example
# Copy this file and update values before deploying

# Docker Registry Configuration
DOCKER_REGISTRY=your-registry.example.com
DOCKER_IMAGE_NAME=qms-server
DOCKER_IMAGE_TAG=latest

# Domain Configuration
DOMAIN=qms.mkcodergr.eu

# Let's Encrypt Configuration
LETSENCRYPT_EMAIL=admin@mkcodergr.eu

# MySQL Configuration
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=changeme_app_password

# Storage Configuration
MYSQL_STORAGE_SIZE=10Gi

# Application Configuration
QMS_REPLICAS=2
QMS_MEMORY_REQUEST=256Mi
QMS_MEMORY_LIMIT=512Mi
QMS_CPU_REQUEST=250m
QMS_CPU_LIMIT=500m

# Namespace
NAMESPACE=qms
